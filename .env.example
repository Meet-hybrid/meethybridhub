# Copy to .env (or export these) before running.
# All values below match the built-in local defaults — change only what differs.

# PostgreSQL connection (local default: docker postgres)
DB_URL=jdbc:postgresql://localhost:5433/meethybridhub
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server port
PORT=8080

# Frontend configuration (set in the storefront hosting environment)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_PAYMENTS_ENABLED=false
